+/* ---- AF snapshot: expose rawaf fv grid via debugfs for external AF daemon ---- */
+static struct dentry *af_snap_dir;
+static u32 af_snap_v1[225], af_snap_v2[225], af_snap_h1[225], af_snap_h2[225];
+static u32 af_snap_sum_b, af_snap_lum_b;
+static u64 af_snap_time;
+static DEFINE_SPINLOCK(af_snap_lock);
+
+static int af_snap_show(struct seq_file *m, void *v)
+{
+	unsigned long flags;
+	int i;
+	spin_lock_irqsave(&af_snap_lock, flags);
+	seq_printf(m, "time=%llu\n", af_snap_time);
+	seq_printf(m, "sum_b=%u lum_b=%u\n", af_snap_sum_b, af_snap_lum_b);
+	for (i = 0; i < 225; i++)
+		seq_printf(m, "%u %u %u %u\n",
+			   af_snap_v1[i], af_snap_v2[i], af_snap_h1[i], af_snap_h2[i]);
+	spin_unlock_irqrestore(&af_snap_lock, flags);
+	return 0;
+}
+static int af_snap_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, af_snap_show, NULL);
+}
+
+static const struct file_operations af_snap_show_fops = {
+	.owner = THIS_MODULE,
+	.open = af_snap_open,
+	.read = seq_read,
+	.llseek = seq_lseek,
+	.release = single_release,
+};
+/* ---- end AF snapshot ---- */
+
